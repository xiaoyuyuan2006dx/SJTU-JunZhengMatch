<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="JunZhenMatch" Manufacturer="xiaoyuyuan2006dx" Version="$(var.Version)" UpgradeCode="4BBF6F5A-0C4D-4F1C-9F3C-6CA82C89C31F" Language="2052" Scope="perUser" Codepage="65001">
    <MajorUpgrade MigrateFeatures="no" Schedule="afterInstallInitialize" DowngradeErrorMessage="已安装较新版本，请在该版本维护页面中修复或卸载。" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Binary Id="InstallerArtwork" SourceFile="build/installer-background.bmp" />
    <Binary Id="InstallerErrorIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/xiaoyuyuan2006dx/SJTU-JunZhengMatch" />
    <Property Id="JZDATADIR" Secure="yes" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <Property Id="JZOPERATION" Value="install" />
    <Property Id="JZPROGRESSTITLE" Value="正在安装" />
    <Property Id="JZCOMPLETIONTITLE" Value="安装完成" />
    <StandardDirectory Id="WindowsFolder" />
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="JZDATADIR" Name="JunZhenMatchData" />
    </StandardDirectory>
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="ExistingInstallDir" Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="UsePreviousInstallDir" Value="[PREVIOUSINSTALLFOLDER]" Before="CostInitialize" Sequence="both" Condition="NOT INSTALLFOLDER AND PREVIOUSINSTALLFOLDER" />
    <Property Id="PREVIOUSJZDATADIR">
      <RegistrySearch Id="ExistingDataDir" Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="DataDir" Type="raw" />
    </Property>
    <SetProperty Id="JZDATADIR" Action="UsePreviousDataDir" Value="[PREVIOUSJZDATADIR]" Before="UseDefaultDataDir" Sequence="both" Condition="NOT JZDATADIR AND PREVIOUSJZDATADIR" />
    <SetProperty Id="JZDATADIR" Action="UseDefaultDataDir" Value="[%USERPROFILE]\JunZhenMatch" Before="CostInitialize" Sequence="both" Condition="NOT JZDATADIR" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="JunZhenMatch">
          <Component Id="AppFiles" Guid="F833CD4F-49D1-4216-B2F3-3222CF2A21E7">
            <File Id="MainExe" Source="$(var.AppPath)" />
            <File Id="WebviewBootstrapper" Source="$(var.BootstrapperPath)" />
            <RegistryValue Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="InstalledVersion" Type="string" Value="$(var.Version)" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
            <RemoveFolder Id="RemoveAppFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
            <File Id="DesktopMode" Source="packaging/windows/desktop-mode" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="JunZhenMatch">
        <Component Id="MenuShortcut" Guid="8569805A-A26A-43A5-B622-BAB217BB11CC">
          <Shortcut Id="LaunchDesktop" Name="䇹政导师匹配" Target="[#MainExe]" Arguments="--desktop" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="MenuInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="D08DE7C3-C6BD-43F7-A020-CFDE9AD81D01">
        <Shortcut Id="DesktopLaunch" Name="䇹政导师匹配" Target="[#MainExe]" Arguments="--desktop" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\TaroDeluxe\JunZhenMatch" Name="DesktopInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Complete" Title="JunZhenMatch" Level="1" AllowAdvertise="no" AllowAbsent="no" InstallDefault="local">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="MenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <CustomAction Id="ConfigureStorage" FileRef="MainExe" ExeCommand="--configure-data &quot;[JZDATADIR]\.&quot; --no-open" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="PreserveStorageOnRepair" FileRef="MainExe" ExeCommand="--configure-data &quot;[JZDATADIR]\.&quot; --keep-existing-settings --no-open" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RequireLocalPayload" Error="程序文件没有被选中安装，本次操作未完成。请重新打开安装包，选择安装或修复安装。" />
    <CustomAction Id="RejectInvalidDataLocation" Error="数据目录不能与程序安装目录相同，也不能放在程序目录里面。请选择两个分开的文件夹，例如程序放在D:\Apps\JunZhenMatch，数据放在D:\JunZhenMatchData。" />
    <CustomAction Id="OpenProgramFolder" Directory="WindowsFolder" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER].&quot;" Return="asyncNoWait" />
    <CustomAction Id="OpenInstallLog" Directory="WindowsFolder" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; /select,&quot;[MsiLogFileLocation]&quot;" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="CheckRollbackAccess" Before="InstallInitialize" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="RejectInvalidDataLocation" Before="RequireLocalPayload" Condition="NOT Installed AND NOT REMOVE AND (JZDATADIR ~&lt;&lt; INSTALLFOLDER)" />
      <Custom Action="RequireLocalPayload" Before="InstallInitialize" Condition="NOT REMOVE AND NOT ($AppFiles=3 OR ?AppFiles=3)" />
      <Custom Action="ConfigureStorage" Before="PreserveStorageOnRepair" Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND $AppFiles=3" />
      <Custom Action="PreserveStorageOnRepair" Before="InstallFinalize" Condition="Installed AND NOT REMOVE~=&quot;ALL&quot; AND $AppFiles=3" />
    </InstallExecuteSequence>
    <UI>
      <Property Id="ErrorDialog" Value="InstallerErrorDlg" />
      <ProgressText Action="InstallValidate" Message="正在检查安装条件" />
      <ProgressText Action="InstallFiles" Template="[1]" Message="正在复制程序文件" />
      <ProgressText Action="CreateShortcuts" Template="[1]" Message="正在创建快捷方式" />
      <ProgressText Action="WriteRegistryValues" Template="[1]" Message="正在写入安装信息" />
      <ProgressText Action="ConfigureStorage" Message="正在保存数据位置" />
      <ProgressText Action="PreserveStorageOnRepair" Message="正在保留原有设置" />
      <ProgressText Action="RemoveExistingProducts" Message="正在移除旧版本" />
      <ProgressText Action="RemoveFiles" Template="[1]" Message="正在卸载程序文件" />
      <ProgressText Action="InstallFinalize" Message="正在完成安装" />
      <TextStyle Id="DefaultFont" FaceName="Microsoft YaHei UI" Size="9" Red="91" Green="83" Blue="99" />
      <TextStyle Id="TitleFont" FaceName="Microsoft YaHei UI" Size="15" Bold="yes" Red="124" Green="90" Blue="128" />
      <Property Id="DefaultUIFont" Value="DefaultFont" />
      <Dialog Id="StorageSetupDlg" Width="640" Height="342" Title="JunZhenMatch 安装" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Title" Type="Text" X="20" Y="18" Width="280" Height="30" Text="{\TitleFont}安装䇹政导师匹配" Transparent="yes" />
        <Control Id="Version" Type="Text" X="310" Y="24" Width="90" Height="18" Text="v[ProductVersion]" Transparent="yes" />
        <Control Id="Intro" Type="Text" X="20" Y="55" Width="380" Height="30" Text="选择程序和数据的位置。" Transparent="yes" />
        <Control Id="ProgramLabel" Type="Text" X="20" Y="98" Width="380" Height="17" Text="程序位置：" Transparent="yes" />
        <Control Id="ProgramPath" Type="PathEdit" X="20" Y="118" Width="380" Height="20" Property="INSTALLFOLDER" />
        <Control Id="DataLabel" Type="Text" X="20" Y="153" Width="380" Height="17" Text="数据位置：" Transparent="yes" />
        <Control Id="DataPath" Type="PathEdit" X="20" Y="173" Width="380" Height="20" Property="JZDATADIR" />
        <Control Id="Hint" Type="Text" X="20" Y="203" Width="380" Height="45" Text="程序和数据分开保存，卸载保留数据。" Transparent="yes" />
        <Control Id="Install" Type="PushButton" X="245" Y="300" Width="75" Height="22" Default="yes" Text="安装">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" Condition="1" />
          <Publish Event="SetTargetPath" Value="JZDATADIR" Order="2" Condition="1" />
          <Publish Event="SpawnDialog" Value="InvalidStorageDlg" Order="3" Condition="JZDATADIR ~&lt;&lt; INSTALLFOLDER" />
          <Publish Event="AddLocal" Value="ALL" Order="4" Condition="JZDATADIR AND NOT (JZDATADIR ~&lt;&lt; INSTALLFOLDER)" />
          <Publish Event="EndDialog" Value="Return" Order="5" Condition="JZDATADIR AND NOT (JZDATADIR ~&lt;&lt; INSTALLFOLDER)" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="327" Y="300" Width="73" Height="22" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="InvalidStorageDlg" Width="380" Height="155" Title="请调整数据目录" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="20" Y="20" Width="340" Height="85" Text="数据目录不能与程序安装目录相同，也不能放在程序目录里面。请返回修改。&#13;&#10;&#13;&#10;例如：程序放在D:\Apps\JunZhenMatch，数据放在D:\JunZhenMatchData。" Transparent="yes" />
        <Control Id="Back" Type="PushButton" X="245" Y="118" Width="110" Height="22" Default="yes" Cancel="yes" Text="返回修改">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="MaintenanceDlg" Width="640" Height="342" Title="JunZhenMatch 维护" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Title" Type="Text" X="20" Y="18" Width="280" Height="30" Text="{\TitleFont}修复或卸载" Transparent="yes" />
        <Control Id="Version" Type="Text" X="310" Y="24" Width="90" Height="18" Text="v[ProductVersion]" Transparent="yes" />
        <Control Id="Intro" Type="Text" X="20" Y="65" Width="380" Height="70" Text="当前版本已安装，可修复或卸载。&#10;操作前请先退出程序，数据与设置会保留。" Transparent="yes" />
        <Control Id="Location" Type="Text" X="20" Y="145" Width="380" Height="55" Text="程序位置：[INSTALLFOLDER]" Transparent="yes" />
        <Control Id="AdminRetry" Type="PushButton" X="20" Y="225" Width="130" Height="23" Text="管理员模式重试">
          <Publish Event="DoAction" Value="RestartElevated" Order="1" Condition="1" />
          <Publish Event="EndDialog" Value="Exit" Order="2" Condition="JZELEVATIONHANDOFF=1" />
        </Control>
        <Control Id="Repair" Type="PushButton" X="85" Y="275" Width="105" Height="25" Default="yes" Text="修复安装">
          <Publish Event="AddLocal" Value="ALL" Order="1" Condition="!Complete&lt;&gt;3" />
          <Publish Event="ReinstallMode" Value="amus" Order="2" Condition="1" />
          <Publish Event="Reinstall" Value="ALL" Order="3" Condition="!Complete=3" />
          <Publish Event="EndDialog" Value="Return" Order="4" Condition="1" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="200" Y="275" Width="95" Height="25" Text="卸载程序">
          <Publish Property="JZOPERATION" Value="uninstall" Order="1" Condition="1" />
          <Publish Property="JZPROGRESSTITLE" Value="正在卸载" Order="2" Condition="1" />
          <Publish Event="Remove" Value="ALL" Order="3" Condition="1" />
          <Publish Event="EndDialog" Value="Return" Order="4" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="305" Y="275" Width="95" Height="25" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="ProgressDlg" Width="640" Height="342" Title="[JZPROGRESSTITLE]" Modeless="yes" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Title" Type="Text" TabSkip="no" X="20" Y="42" Width="380" Height="25" Text="[JZPROGRESSTITLE]…" Transparent="yes" />
        <Control Id="ActionText" Type="Text" X="20" Y="108" Width="380" Height="20" Text="正在准备安装…" Transparent="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ActionData" Type="Text" X="20" Y="132" Width="380" Height="30" Transparent="yes">
          <Subscribe Event="ActionData" Attribute="Text" />
        </Control>
        <Control Id="Progress" Type="ProgressBar" X="20" Y="172" Width="380" Height="15" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="TimeHint" Type="Text" X="20" Y="205" Width="380" Height="55" Text="通常约10–30秒，请稍候。" Transparent="yes" />
      </Dialog>
      <Dialog Id="InstallerErrorDlg" Width="400" Height="175" Title="JunZhenMatch 安装错误" ErrorDialog="yes">
        <Control Id="ErrorIcon" Type="Icon" X="18" Y="18" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="InstallerErrorIcon" />
        <Control Id="ErrorText" Type="Text" TabSkip="no" X="52" Y="18" Width="330" Height="105" NoPrefix="yes" Text="操作遇到错误。" Transparent="yes" />
        <Control Id="O" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="确定">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="C" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="取消">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="A" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="终止">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="R" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="重试">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="I" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="忽略">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="Y" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="是">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="N" Type="PushButton" TabSkip="yes" X="285" Y="140" Width="90" Height="22" Text="否">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
      </Dialog>
      <Dialog Id="ExitDialog" Width="640" Height="342" Title="[JZCOMPLETIONTITLE]" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Message" Type="Text" X="20" Y="65" Width="380" Height="95" HideCondition="JZOPERATION=&quot;uninstall&quot;" Text="1. 双击桌面或开始菜单的快捷方式打开。&#10;&#10;2. 退出时，请点击程序右上角的退出图案。" Transparent="yes" />
        <Control Id="ProgramLocation" Type="Text" X="20" Y="175" Width="380" Height="40" HideCondition="JZOPERATION=&quot;uninstall&quot;" Text="程序位置：[INSTALLFOLDER]" Transparent="yes" />
        <Control Id="RemovedMessage" Type="Text" X="20" Y="75" Width="380" Height="100" Hidden="yes" ShowCondition="JZOPERATION=&quot;uninstall&quot;" Text="程序和快捷方式已移除。&#10;&#10;教师库、备份、导出结果和设置保留在原存储目录。&#10;确认不再需要后，可自行删除该数据目录。" Transparent="yes" />
        <Control Id="RetainedDataLocation" Type="Text" X="20" Y="180" Width="380" Height="50" Hidden="yes" ShowCondition="JZOPERATION=&quot;uninstall&quot;" Text="数据位置：[JZRETAINEDDATADIR]" Transparent="yes" />
        <Control Id="OpenData" Type="PushButton" X="20" Y="240" Width="130" Height="22" Hidden="yes" ShowCondition="JZOPERATION=&quot;uninstall&quot;" Text="打开数据文件夹">
          <Publish Event="DoAction" Value="OpenRetainedDataFolder" Condition="JZRETAINEDDATADIR" />
        </Control>
        <Control Id="LogLocation" Type="Text" X="20" Y="215" Width="380" Height="18" Text="安装日志：[MsiLogFileLocation]" Hidden="yes" Transparent="yes" />
        <Control Id="OpenFolder" Type="PushButton" X="155" Y="240" Width="120" Height="22" HideCondition="JZOPERATION=&quot;uninstall&quot;" Text="程序文件夹">
          <Publish Event="DoAction" Value="OpenProgramFolder" Condition="1" />
        </Control>
        <Control Id="OpenLog" Type="PushButton" X="150" Y="240" Width="105" Height="22" Text="查看安装日志" Hidden="yes">
          <Publish Event="DoAction" Value="OpenInstallLog" Condition="MsiLogFileLocation" />
        </Control>
        <Control Id="Finish" Type="PushButton" X="325" Y="300" Width="75" Height="22" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Launch" Type="PushButton" X="20" Y="240" Width="120" Height="22" Text="立即打开" HideCondition="JZOPERATION=&quot;uninstall&quot;">
          <Publish Event="DoAction" Value="LaunchInstalledApp" Order="1" Condition="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="FatalError" Width="640" Height="342" Title="安装失败" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Message" Type="Text" X="20" Y="75" Width="380" Height="65" Text="安装未完成，请查看日志。" Transparent="yes" />
        <Control Id="LogLocation" Type="Text" X="20" Y="150" Width="380" Height="70" Text="安装日志：[MsiLogFileLocation]" Transparent="yes" />
        <Control Id="AdminRetry" Type="PushButton" X="155" Y="240" Width="130" Height="22" Text="管理员模式重试">
          <Publish Event="DoAction" Value="RestartElevated" Order="1" Condition="1" />
          <Publish Event="EndDialog" Value="Exit" Order="2" Condition="JZELEVATIONHANDOFF=1" />
        </Control>
        <Control Id="OpenLog" Type="PushButton" X="20" Y="240" Width="120" Height="22" Text="查看安装日志">
          <Publish Event="DoAction" Value="OpenInstallLog" Condition="MsiLogFileLocation" />
        </Control>
        <Control Id="Finish" Type="PushButton" X="325" Y="300" Width="75" Height="22" Default="yes" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="UserExit" Width="640" Height="342" Title="安装已取消" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Message" Type="Text" X="20" Y="75" Width="380" Height="100" Text="安装已取消。" Transparent="yes" />
        <Control Id="Finish" Type="PushButton" X="325" Y="300" Width="75" Height="22" Default="yes" Cancel="yes" Text="关闭">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="UpgradeConfirmDlg" Width="640" Height="342" Title="发现已有版本" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Title" Type="Text" X="20" Y="24" Width="380" Height="30" Text="{\TitleFont}发现已有版本" Transparent="yes" />
        <Control Id="Message" Type="Text" X="20" Y="90" Width="380" Height="90" Text="已安装 v[JZINSTALLEDVERSION]&#10;是否升级到 v[ProductVersion]？&#10;&#10;教师数据和设置会保留。" Transparent="yes" />
        <Control Id="AdminRetry" Type="PushButton" X="20" Y="285" Width="130" Height="24" Text="管理员模式重试">
          <Publish Event="DoAction" Value="RestartElevated" Order="1" Condition="1" />
          <Publish Event="EndDialog" Value="Exit" Order="2" Condition="JZELEVATIONHANDOFF=1" />
        </Control>
        <Control Id="Accept" Type="PushButton" X="190" Y="285" Width="125" Height="24" Default="yes" Text="升级">
          <Publish Event="EndDialog" Value="Return" Order="2" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="325" Y="285" Width="75" Height="24" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="NewerVersionDlg" Width="640" Height="342" Title="已安装较新版本" NoMinimize="yes">
        <Control Id="Artwork" Type="Bitmap" X="0" Y="0" Width="640" Height="342" TabSkip="yes" Text="InstallerArtwork" />
        <Control Id="Title" Type="Text" X="20" Y="24" Width="380" Height="30" Text="{\TitleFont}已安装较新版本" Transparent="yes" />
        <Control Id="Message" Type="Text" X="20" Y="90" Width="380" Height="90" Text="已安装 v[JZINSTALLEDVERSION]，高于本安装包 v[ProductVersion]。&#10;&#10;可进入已安装版本的维护页面修复或卸载。" Transparent="yes" />
        <Control Id="Accept" Type="PushButton" X="190" Y="285" Width="125" Height="24" Default="yes" Text="修复或卸载">
          <Publish Event="DoAction" Value="OpenExistingMaintenance" Order="2" Condition="1" />
          <Publish Event="EndDialog" Value="Exit" Order="3" Condition="1" />
          <Publish Property="JZMAINTENANCEHANDOFF" Value="1" Order="1" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="325" Y="285" Width="75" Height="24" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="StorageSetupDlg" After="UpgradeConfirmDlg" Condition="NOT Installed" />
      <Show Dialog="MaintenanceDlg" After="StorageSetupDlg" Condition="Installed AND NOT REMOVE" />
      <Show Dialog="ProgressDlg" Before="ExecuteAction" />
      <Show Dialog="ExitDialog" OnExit="success" />
      <Show Dialog="FatalError" OnExit="error" />
      <Show Dialog="UserExit" OnExit="cancel" Condition="NOT JZMAINTENANCEHANDOFF AND NOT JZELEVATIONHANDOFF" />
      <Custom Action="DetectRelatedVersion" After="FindRelatedProducts" />
      <Show Dialog="NewerVersionDlg" Before="LaunchConditions" Condition="WIX_DOWNGRADE_DETECTED" />
      <Show Dialog="UpgradeConfirmDlg" After="CostFinalize" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="StartInstallActivity" After="DetectRelatedVersion" />
      <Custom Action="MarkDirectUninstall" Before="MarkUninstallProgress" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="MarkUninstallProgress" Before="MarkUninstallCompletion" Condition="JZOPERATION=&quot;uninstall&quot;" />
      <Custom Action="MarkUninstallCompletion" Before="CaptureRetainedDataLocation" Condition="JZOPERATION=&quot;uninstall&quot;" />
      <Custom Action="CaptureRetainedDataLocation" Before="ProgressDlg" Condition="JZOPERATION=&quot;uninstall&quot;" />
    </InstallUISequence>
    <Binary Id="MaintenanceHost" SourceFile="build/MaintenanceHost.exe" />
    <CustomAction Id="RestartElevated" BinaryRef="InstallerUiHelper" DllEntry="RestartElevated" Return="ignore" />
    <Binary Id="InstallerUiHelper" SourceFile="$(var.UiHelperPath)" />
    <CustomAction Id="StartInstallActivity" BinaryRef="InstallerUiHelper" DllEntry="StartActivity" Return="ignore" />
    <CustomAction Id="DetectRelatedVersion" BinaryRef="InstallerUiHelper" DllEntry="DetectRelatedVersion" Return="check" />
    <CustomAction Id="CheckRollbackAccess" BinaryRef="InstallerUiHelper" DllEntry="CheckRollbackAccess" Return="check" />
    <CustomAction Id="MarkDirectUninstall" Property="JZOPERATION" Value="uninstall" />
    <CustomAction Id="MarkUninstallProgress" Property="JZPROGRESSTITLE" Value="正在卸载" />
    <CustomAction Id="MarkUninstallCompletion" Property="JZCOMPLETIONTITLE" Value="卸载完成" />
    <CustomAction Id="CaptureRetainedDataLocation" BinaryRef="InstallerUiHelper" DllEntry="CaptureRetainedDataLocation" Return="check" />
    <CustomAction Id="OpenRetainedDataFolder" BinaryRef="InstallerUiHelper" DllEntry="OpenRetainedDataFolder" Return="ignore" />
    <CustomAction Id="OpenExistingMaintenance" BinaryRef="InstallerUiHelper" DllEntry="OpenExistingMaintenance" Return="check" />
    <CustomAction Id="LaunchInstalledApp" FileRef="MainExe" ExeCommand="--desktop" Return="asyncNoWait" />
  </Package>
</Wix>
